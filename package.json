{
  "name": "podframes",
  "version": "0.1.0",
  "private": true,
  "description": "Two-host AI podcast videos with local Codex, Fish Audio, P-Video, LTX, HeyGen, and HyperFrames.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jellypod-Inc/podframes"
  },
  "homepage": "https://github.com/Jellypod-Inc/podframes",
  "bugs": "https://github.com/Jellypod-Inc/podframes/issues",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev:web": "PODFRAMES_LOCAL_ONLY=true pnpm --filter @podframes/web dev",
    "build:web": "pnpm --filter @podframes/web build",
    "generate": "pnpm --filter podframes-cli start",
    "podframes": "pnpm --filter podframes-cli start --",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "worker": "node --import tsx scripts/worker.mts",
    "producer": "node --import tsx scripts/producer.mts",
    "production": "node --import tsx scripts/production.mts"
  },
  "keywords": [
    "podcast",
    "fish-audio",
    "codex",
    "heygen",
    "hyperframes",
    "lip-sync"
  ],
  "devDependencies": {
    "@podframes/core": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
